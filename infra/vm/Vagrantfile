# infra/vm/Vagrantfile
# Movies API on K3s + Floci + Terraform: dev VM (Ubuntu 24.04, x86_64)
# K3s is NOT installed here (Prompt 3). Floci is NOT started here (Prompt 2).

Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_architecture = "amd64"
  config.vm.hostname = "movies-lab"

  # Keep the code inside the VM (clone to ~/movies); the Windows share is slow for Go/Docker.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Ports reachable from Windows only (127.0.0.1), not from your LAN.
  # SSH 2222 -> 22 is forwarded by Vagrant automatically.
  config.vm.network "forwarded_port", guest: 80,   host: 8080, host_ip: "127.0.0.1" # Traefik -> Movies app
  config.vm.network "forwarded_port", guest: 4566, host: 4566, host_ip: "127.0.0.1" # Floci (AWS emulator)

  config.vm.provider "virtualbox" do |vb|
    vb.name = "MoviesLab"
    vb.memory = "8192"   # minimum 6144 if your PC is tight
    vb.cpus = 4
  end

  # ---- 1. System tools (runs as root) ----
  config.vm.provision "shell", inline: <<-SHELL
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update -y
    apt-get install -y \
      apt-transport-https ca-certificates curl gnupg lsb-release \
      software-properties-common unzip git jq make

    echo "=== Docker CE ==="
    install -m 0755 -d /etc/apt/keyrings
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
    chmod a+r /etc/apt/keyrings/docker.asc
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] \
      https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" | \
      tee /etc/apt/sources.list.d/docker.list > /dev/null
    apt-get update -y
    apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
    usermod -aG docker vagrant
    systemctl enable --now docker

    echo "=== Go ==="
    # Must be >= the version in the project's go.mod. Check that it exists on https://go.dev/dl/
    GO_VERSION="1.27.3"
    curl -fLO "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"
    rm -rf /usr/local/go
    tar -C /usr/local -xzf "go${GO_VERSION}.linux-amd64.tar.gz"
    rm "go${GO_VERSION}.linux-amd64.tar.gz"

    cat > /etc/profile.d/golang.sh << 'EOF'
export PATH=$PATH:/usr/local/go/bin
export GOPATH=/home/vagrant/go
export PATH=$PATH:$GOPATH/bin
EOF
    chmod +x /etc/profile.d/golang.sh
    export PATH=$PATH:/usr/local/go/bin

    echo "=== Terraform ==="
    rm -f /usr/share/keyrings/hashicorp-archive-keyring.gpg
    curl -fsSL https://apt.releases.hashicorp.com/gpg | \
      gpg --dearmor | tee /usr/share/keyrings/hashicorp-archive-keyring.gpg > /dev/null
    chmod a+r /usr/share/keyrings/hashicorp-archive-keyring.gpg
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] \
      https://apt.releases.hashicorp.com $(lsb_release -cs) main" | \
      tee /etc/apt/sources.list.d/hashicorp.list > /dev/null
    apt-get update -y
    apt-get install -y terraform

    echo "=== AWS CLI v2 ==="
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o awscliv2.zip
    unzip -q awscliv2.zip
    ./aws/install
    rm -rf awscliv2.zip ./aws

    echo "=== SAM CLI ==="
    curl -fsSL "https://github.com/aws/aws-sam-cli/releases/latest/download/aws-sam-cli-linux-x86_64.zip" -o aws-sam-cli.zip
    unzip -q aws-sam-cli.zip -d sam-installation
    ./sam-installation/install
    rm -rf aws-sam-cli.zip ./sam-installation

    echo "=== Versions ==="
    docker --version
    aws --version
    sam --version
    go version
    terraform version
  SHELL

  # ---- 2. Per-user setup (runs as vagrant, so files land in /home/vagrant) ----
  config.vm.provision "shell", privileged: false, inline: <<-SHELL
    set -e
    # Mock credentials for Floci only. Never real AWS keys.
    aws configure set aws_access_key_id "mock_key" --profile local-dev
    aws configure set aws_secret_access_key "mock_secret" --profile local-dev
    aws configure set region "us-east-1" --profile local-dev
    aws configure set output "json" --profile local-dev
  SHELL
end
