# PostgreSQL connection settings
DB_HOST=db
DB_PORT=5432
DB_USER=movies
DB_PASSWORD=replace_with_a_local_password
DB_NAME=movies
DB_SSLMODE=disable
DATABASE_URL=postgres://movies:replace_with_a_local_password@db:5432/movies?sslmode=disable

# pgAdmin web UI (use a strong local password)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=replace_with_a_local_pgadmin_password

# HTTP server settings
APP_PORT=8080
ALLOWED_ORIGIN=*

# PostgreSQL connection pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
